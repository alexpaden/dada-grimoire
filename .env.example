# =============================================================================
#  GRIMOIRE CTF — environment template
#  Copy to .env and fill real values, or run:  ./scripts/gen-flags.sh
#  The real .env is gitignored. Source references env NAMES only; never values.
# =============================================================================

# --- Networking / LAN ---------------------------------------------------------
# HOST_IP = the instructor machine's LAN IP. Client JS calls the API at this IP
# (not localhost), so student laptops on the class wifi can reach it.
HOST_IP=127.0.0.1
FRONTEND_PORT=3000
BACKEND_PORT=8000
POSTGRES_PORT=5432

# --- Django secrets -----------------------------------------------------------
# SECRET_KEY: Django's signing key.
SECRET_KEY=changeme-django-secret-key
# GRIMOIRE_SALT: per-install deployment seed used to derive signing keys.
GRIMOIRE_SALT=changeme-grimoire-salt
# Verbose diagnostics for the class environment.
DJANGO_DEBUG=True

# --- Kiosk / TV admin session -------------------------------------------------
# KIOSK_SECRET arms the /tv admin session — paste it into the masked 'kiosk secret'
# field on /tv (never in the URL). Also gates the deface endpoint.
KIOSK_SECRET=changeme-kiosk-secret

# --- Per-deployment policy profiles -------------------------------------------
# Operator-provisioned per instance; the live values are NOT in this repo (the
# operator sets them in this gitignored .env per their run notes). Left blank,
# the app falls back to its safe built-in defaults. 'make up' refuses to start
# until they are set, so a deployment can't silently ship the wrong policy.
IDENTITY_PROFILE=
TV_RENDER_PROFILE=
TOKEN_PROFILE=

# --- Postgres -----------------------------------------------------------------
POSTGRES_DB=grimoire
POSTGRES_USER=grimoire
POSTGRES_PASSWORD=changeme-db-pass

# =============================================================================
#  SCORING TOKENS — generated fresh per class by scripts/gen-flags.sh
# =============================================================================
GRIMOIRE_SLOT_A=flag{REPLACE_a}
GRIMOIRE_SLOT_B=flag{REPLACE_b}
GRIMOIRE_SLOT_C=flag{REPLACE_c}
GRIMOIRE_SLOT_D=flag{REPLACE_d}
GRIMOIRE_SLOT_E=flag{REPLACE_e}
GRIMOIRE_SLOT_F=flag{REPLACE_f}
GRIMOIRE_SLOT_G=flag{REPLACE_g}

# --- Worker marker -----------------------------------------------------------
# Distinctive value mounted only into the isolated worker runtime. The worker
# logs when this value shows up in restore output, so instructors can verify
# a capture from logs or the room display.
JOB_MARKER=marker{REPLACE_worker_proof}

# Where the browser should reach the API (set to http://HOST_IP:BACKEND_PORT for LAN)
NEXT_PUBLIC_API_BASE=http://127.0.0.1:8000
